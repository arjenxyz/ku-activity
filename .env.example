# CrewLedger — ortam değişkenleri örneği
# Kopyalayın: .env.local

# Supabase (zorunlu)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Uygulama URL (TWA / manifest ikonları için)
NEXT_PUBLIC_APP_URL=https://crewledger.vercel.app

# Google Play TWA — Digital Asset Links
TWA_PERSONNEL_PACKAGE_ID=app.crewledger.personel
TWA_ADMIN_PACKAGE_ID=app.crewledger.admin
# SHA-256 sertifika parmak izleri (virgülle ayırın)
# npm run twa:fingerprint ile keystore'dan alın
TWA_PERSONNEL_SHA256_FINGERPRINTS=
TWA_ADMIN_SHA256_FINGERPRINTS=

# Google Play mağaza sayfaları (yayınlandıktan sonra)
NEXT_PUBLIC_PLAY_STORE_PERSONNEL_URL=
NEXT_PUBLIC_PLAY_STORE_ADMIN_URL=

# KVKK / platform — gönüllülük projesi (tüzel kişilik yok)
PLATFORM_NAME=
PLATFORM_NATURE=
PLATFORM_DEVELOPER_NAME=Arjen
PLATFORM_DEVELOPER_ROLE=bireysel geliştirici ve platform operatörü
PLATFORM_CONTACT_EMAIL=

# Eski COMPANY_* değişkenleri artık kullanılmıyor (geriye dönük uyumluluk yok)

# İsteğe bağlı destek
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_SUPPORT_WHATSAPP=
# Ekran raporu — Discord (önerilen)
# Kanal: 1522557902278365184 | Sunucu: 1465698764453838882
# Webhook (kolay): Kanal → Entegrasyonlar → Webhook oluştur
DISCORD_REPORT_WEBHOOK_URL=
# veya Bot token + kanal ID (botun kanala mesaj gönderme yetkisi olmalı)
DISCORD_BOT_TOKEN=
DISCORD_REPORT_CHANNEL_ID=1522557902278365184
# E-posta yedek (Discord yapılandırılmazsa)
DEVELOPER_REPORT_EMAIL=

# Avans dekont depolama (ücretsiz plan — Supabase Storage kullanılmaz)
# google_drive (varsayılan) veya r2
STORAGE_BACKEND=google_drive

# Google Cloud → Service Account → Keys → JSON indir
# İsteğe bağlı: Cloud Vision API (ücretli — faturalandırma gerekir)
# DEKONT_OCR_PROVIDER=tesseract ile Vision olmadan ücretsiz OCR kullanılır (varsayılan: auto)
# auto = Tesseract önce, Vision yedek | tesseract = sadece Tesseract | vision = sadece Vision
DEKONT_OCR_PROVIDER=auto
# Dosyanın TAMAMINI buraya yapıştırın (tek satır olabilir; Vercel'de aynı şekilde)
# Örnek yapı (gerçek private_key kullanmayın — kendi indirdiğiniz dosyayı yapıştırın):
# GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"proje-adiniz","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"xxx@proje.iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"...","universe_domain":"googleapis.com"}
GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON=

# Drive klasör URL'sinden ID: drive.google.com/drive/folders/BURASI
# Klasörü client_email adresiyle Düzenleyici olarak paylaşın
GOOGLE_DRIVE_DEKONT_FOLDER_ID=1HevccALUUjzz6-wE0qzb3obxwrdVxFjY
# Cloudflare R2 (STORAGE_BACKEND=r2 ise)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Web Push (personel bildirimleri — VAPID)
# Oluşturmak için: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@crewledger.app

# Cron (cron-job.org — Vercel Cron kullanılmıyor)
# Her job'da HTTP Header: Authorization = Bearer <CRON_SECRET>
# Keepalive: GET https://crewledger.vercel.app/api/cron/supabase-keepalive (6–12 saatte bir)
# Yoklama hatırlatması: GET https://crewledger.vercel.app/api/cron/personnel-notifications (günde 2–4 kez, 17–22 TR)
CRON_SECRET=
