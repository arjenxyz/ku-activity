# EVENT MANAGEMENT SYSTEM — ortam değişkenleri örneği
# Kopyalayın: .env.local
#
# ÖNEMLİ: Yeni boş bir Supabase projesi kullanın.
# Eski CrewLedger veritabanına bağlanmayın / migration çalıştırmayın.

# Supabase (zorunlu) — service role asla client'a çıkmaz
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Uygulama URL (boş bırakılabilir — Vercel/custom domain sonra)
NEXT_PUBLIC_APP_URL=

# Opsiyonel cron koruması
CRON_SECRET=
