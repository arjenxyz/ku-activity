# CrewLedger — ortam değişkenleri şablonu
# Kopyala: cp .env.example .env.local

# Supabase (zorunlu)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Hassas veri şifreleme — 64 hex karakter (32 byte)
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FIELD_ENCRYPTION_KEY=

# Uygulama URL (yerel geliştirme)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Production (Vercel): https://crewledger.vercel.app

# Brevo e-posta (OTP, hatırlatma)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=CrewLedger

# Opsiyonel
CRON_SECRET=
REDIS_URL=
REDIS_TOKEN=
NEXT_PUBLIC_SUPPORT_EMAIL=hello@crewledger.app
NEXT_PUBLIC_OFFICIAL_MINIMUM_WAGE_GROSS=33030
NEXT_PUBLIC_OFFICIAL_MINIMUM_WAGE_NET=28075.5

# Şirket bilgileri (sözleşme / KVKK)
COMPANY_LEGAL_NAME=
COMPANY_TRADE_NAME=
COMPANY_EMAIL=
COMPANY_PHONE=
